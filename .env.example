# Variables de entorno del backend de visión
# Copia este fichero como .env y rellena tu clave real.
# NUNCA subas .env a Git.

# Clave de API de Google Gemini
# Obtén una en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternativa compatible con el SDK oficial
# GOOGLE_API_KEY=your_google_api_key_here

# Puerto del servidor de visión (por defecto: 3001)
VISION_SERVER_PORT=3001
